# Server-side only. Do not place the project key in browser code or commit a real value.
BROKER_GAME_ENABLED=false
BROKER_URL=https://aib.zapleo.com
BROKER_PROJECT_KEY=
BROKER_SUBSCRIPTION_MODEL=
# Admin panel (/admin.html). Server-side only.
ADMIN_PASSWORD=
# Optional: signs the 12 h admin session cookie; without it a key derived from ADMIN_PASSWORD is used.
ADMIN_SESSION_SECRET=
# Vercel Blob store for settings/game.json and sponsor logos; set automatically when a Blob store is connected.
BLOB_READ_WRITE_TOKEN=
